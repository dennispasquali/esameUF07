// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Nation {
  id     Int     @id @default(autoincrement())
  name   String
  cities City[]
}

model City {
  id        Int       @id @default(autoincrement())
  name      String
  cap       String
  idNation Int
  nation   Nation   @relation(fields: [idNation], references: [id])
  Customers  Customer[]
}

model User {
  id          Int          @id @default(autoincrement()) // Questo crea un ID seriale (1, 2, 3...)
  name        String
  surname     String
  email       String       @unique // @unique impedisce di avere due utenti con la stessa email
  pwd         String
  employees Employee[]
  admins      Admin[]
  Customers    Customer[]
  orders     Order[]
}

model Employee {
  id       Int    @id @default(autoincrement())
  role    String
  task String
  idUser Int
  user   User @relation(fields: [idUser], references: [id])
}

model Admin {
  id       Int    @id @default(autoincrement())
  idUser Int
  user   User @relation(fields: [idUser], references: [id])
}

model Customer {
  id                 Int          @id @default(autoincrement())
  phonePrefix         String
  phoneNumber            String
  street                String
  civic             Int
  imgProfile         String
  idUser           Int
  user             User       @relation(fields: [idUser], references: [id])
  idCity            Int
  city              City        @relation(fields: [idCity], references: [id])
  reviews        Review[]
}

model Product {
  id                 Int                 @id @default(autoincrement())
  img                String
  title             String
  description        String
  price             Float
  qt            Int 
  weigth        Float
  heigth        Int
  width         Int
  length        Int
  oldPrice      Float?
  shippingDate     DateTime
  reviews        Review[]
  orderWithProducts OrderWithProducts[]
}

model Review {
  id          Int      @id @default(autoincrement())
  idCustomer   Int
  customer     Customer  @relation(fields: [idCustomer], references: [id])
  idProduct  Int
  Product    Product @relation(fields: [idProduct], references: [id])
  description String
  title      String
  rating Float
  date        DateTime
}

model Carosello {
  id      Int     @id @default(autoincrement())
  img     String
  alt     String
  caption String?
}

model Order {
  id                 Int                 @id @default(autoincrement())
  idUser           Int
  user             User              @relation(fields: [idUser], references: [id])
  date               DateTime
  //enum
  //status: 'carrello' | 'Ricevuto' | 'In produzione' | 'Spedito' | 'Consegnato'
  status             String              @default("carrello")
  //enum
  //statusColor: 'none' | 'default' | 'secondary' | 'success' | 'warning',
  statusColor        String              @default("none")
  urlTracking        String
  typeOrder        String
  orderWithProducts OrderWithProducts[]
}

model OrderWithProducts {
  id         Int      @id @default(autoincrement())
  qt         Int
  idProduct Int
  product   Product @relation(fields: [idProduct], references: [id])
  idOrder   Int
  order     Order   @relation(fields: [idOrder], references: [id])
}
